# ---------------------------------------------------------------------------
# H1B Job Board — environment template.
# Copy to `.env` (git-ignored) and fill in. Never commit real secrets.
# ---------------------------------------------------------------------------

# --- Database: PostgreSQL + pgvector on Neon ---------------------------------
# Pooled connection string from the Neon dashboard.
DATABASE_URL="postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# --- e2e: throwaway test database (required to run `pnpm e2e`) ----------------
# A SEPARATE, disposable Neon branch/DB. The Playwright seed TRUNCATEs tables, so
# it refuses to run without this and NEVER falls back to DATABASE_URL. In CI an
# ephemeral Neon branch is created per run and set here. First local run:
#   DATABASE_URL="$E2E_DATABASE_URL" pnpm db:migrate   # build the schema once
#   pnpm e2e
E2E_DATABASE_URL=""

# --- AI: OpenAI (classification + embeddings) --------------------------------
OPENAI_API_KEY=""
# Model overrides (optional — sensible defaults are baked in).
OPENAI_CLASSIFY_MODEL="gpt-4o-mini"
OPENAI_EMBED_MODEL="text-embedding-3-small"
# Résumé tailoring model — defaults to gpt-4.1 for better writing quality.
OPENAI_TAILOR_MODEL="gpt-4.1"
# Optional: route ONLY tailoring to an OpenAI-compatible endpoint to cut cost at
# volume (keyword extraction + embeddings stay on OpenAI above). Both must be set
# to take effect. Example — GLM via OpenRouter:
#   OPENAI_TAILOR_BASE_URL="https://openrouter.ai/api/v1"
#   OPENAI_TAILOR_API_KEY="sk-or-..."
#   OPENAI_TAILOR_MODEL="z-ai/glm-4.6"
OPENAI_TAILOR_BASE_URL=""
OPENAI_TAILOR_API_KEY=""
# Optional: route job CLASSIFICATION to an OpenAI-compatible endpoint too. This
# is the pipeline's bulk cost — one call per new posting — so it's the one worth
# moving onto cheap credits. Both must be set to take effect; set the model with
# OPENAI_CLASSIFY_MODEL above. Example:
#   OPENAI_CLASSIFY_BASE_URL="https://openrouter.ai/api/v1"
#   OPENAI_CLASSIFY_API_KEY="sk-or-..."
#   OPENAI_CLASSIFY_MODEL="google/gemini-2.0-flash-001"
# Validate any swap with `pnpm eval:classify` before a bulk run.
OPENAI_CLASSIFY_BASE_URL=""
OPENAI_CLASSIFY_API_KEY=""

# Job-description embeddings during enrichment. OFF by default: `jobs.embedding`
# is written but never read (résumé relevance uses keyword overlap, and the
# Studio embeds the pasted JD fresh), so filling it is a paid call per posting
# for nothing. Set to 1 only if pgvector job similarity gets built.
ENRICH_EMBEDDINGS=""

# --- Pipeline: Inngest -------------------------------------------------------
# From the Inngest dashboard. Left blank, the local dev server is used.
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# --- Observability: Sentry ---------------------------------------------------
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# For source-map upload in CI (optional locally).
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# --- Ingestion sources (added per-epic; placeholders for now) ----------------
# GitHub API token for reading public community job repos (Epic 2).
GITHUB_TOKEN=""
# Aggregator API — JSearch (RapidAPI) or FlyByAPIs (Epic 2).
AGGREGATOR_API_KEY=""

# --- Resume storage: AWS S3 (Epic 4) -----------------------------------------
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
S3_RESUME_BUCKET=""

# --- Outlook confirmation poller + outreach send: Microsoft Graph ------------
# Delegated auth on a personal Microsoft account (PKCE public client — no secret).
# Register a free Azure app (personal accounts, redirect http://localhost,
# delegated Mail.Read + Mail.Send + offline_access), then run `pnpm outlook:auth`
# to mint the refresh token. If you set this up before outreach send existed,
# re-run `pnpm outlook:auth` to re-consent the added Mail.Send scope.
# MS_TENANT defaults to `consumers` (personal accounts).
MS_CLIENT_ID=""
MS_TENANT="consumers"
MS_REFRESH_TOKEN=""

# --- People-finder: email inference (Apollo / Hunter) ------------------------
# Optional — the people-finder no-ops without a key. Free tiers are low, so
# results are cached (people_cache). Set either or both.
HUNTER_API_KEY=""
APOLLO_API_KEY=""

# Auth (optional): set all three to require login (single owner). Leave unset to keep the app open.
# Generate a secret with: openssl rand -base64 32
AUTH_SECRET=
OWNER_EMAIL=
OWNER_PASSWORD=
