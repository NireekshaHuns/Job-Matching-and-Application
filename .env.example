# ---------------------------------------------------------------------------
# H1B Job Board — environment template.
# Copy to `.env` (git-ignored) and fill in. Never commit real secrets.
# ---------------------------------------------------------------------------

# --- Database: PostgreSQL + pgvector on Neon ---------------------------------
# Pooled connection string from the Neon dashboard.
DATABASE_URL="postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# --- AI: OpenAI (classification + embeddings) --------------------------------
OPENAI_API_KEY=""
# Model overrides (optional — sensible defaults are baked in).
OPENAI_CLASSIFY_MODEL="gpt-4o-mini"
OPENAI_EMBED_MODEL="text-embedding-3-small"

# --- Pipeline: Inngest -------------------------------------------------------
# From the Inngest dashboard. Left blank, the local dev server is used.
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# --- Observability: Sentry ---------------------------------------------------
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# For source-map upload in CI (optional locally).
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# --- Ingestion sources (added per-epic; placeholders for now) ----------------
# GitHub API token for reading public community job repos (Epic 2).
GITHUB_TOKEN=""
# Aggregator API — JSearch (RapidAPI) or FlyByAPIs (Epic 2).
AGGREGATOR_API_KEY=""

# --- Resume storage: AWS S3 (Epic 4) -----------------------------------------
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
S3_RESUME_BUCKET=""

# --- Outlook import: Microsoft Graph (Epic 6) --------------------------------
MS_GRAPH_CLIENT_ID=""
MS_GRAPH_CLIENT_SECRET=""
MS_GRAPH_TENANT_ID=""
